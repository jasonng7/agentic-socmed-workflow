# OpenAI-compatible LLM config (used for extraction analysis and optional IG folder naming)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# Optional OpenRouter fallback
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Vercel/Next.js uses the OpenAI variables above in app/api/analyze/route.ts.
BACKEND_URL=
NEXT_PUBLIC_BACKEND_URL=

# Backend extraction options
BACKEND_USE_WHISPER=false
YOUTUBE_COOKIES_FILE=
YOUTUBE_BROWSER=
